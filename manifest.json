{
  "manifest_version": 3,
  "name": "Currency Converter - Select and Convert",
  "version": "12.0",
  "description": "Select a price on any page and see it converted instantly, in the currencies you choose.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://open.er-api.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://flagcdn.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "currencies.js",
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "THIRD-PARTY-NOTICES.txt"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "Currency Converter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}